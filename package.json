{
  "name": "whatsapp-assistant-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stdio MCP server that lets a Claude Code agent read and post in a fixed allowlist of WhatsApp chats.",
  "license": "Elastic-2.0",
  "author": "Agentic Delivery",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agentic-Delivery/whatsapp-assistant-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "baileys",
    "claude",
    "claude-code",
    "assistant",
    "bridge"
  ],
  "bin": {
    "wa-mcp": "src/mcp-server.js",
    "wa-daemon": "src/daemon.js",
    "wa-pair": "src/pair.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
